---
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import CookieConsent from '../components/monetization/CookieConsent.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
  canonicalUrl?: string;
  noindex?: boolean;
}

const {
  title,
  description = 'Cash Café — la cafetería mejor valorada de Beniel (Murcia). Café de especialidad, desayunos caseros, bocadillos y ambiente familiar. Av. del Reino, 16.',
  ogImage = '/og-default.jpg',
  ogType = 'website',
  canonicalUrl,
  noindex = false,
} = Astro.props;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? '';
const fullTitle = title.includes('Cash Café') ? title : `${title} | Cash Café`;
const resolvedOgImage = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`;
const resolvedCanonical = canonicalUrl ?? Astro.url.href;
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="generator" content={Astro.generator} />

  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={resolvedCanonical} />
  {noindex && <meta name="robots" content="noindex, nofollow" />}

  <!-- Open Graph -->
  <meta property="og:type" content={ogType} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={resolvedOgImage} />
  <meta property="og:url" content={resolvedCanonical} />
  <meta property="og:locale" content="es_ES" />
  <meta property="og:site_name" content="Cash Café" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={resolvedOgImage} />

  <!-- Fonts: Fraunces (display serif) + Inter (sans) + Pacifico (script accent) -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..700;1,9..144,300..600&family=Inter:wght@300;400;500;600;700&family=Pacifico&display=swap"
    rel="stylesheet"
  />

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" href="/assets/cash-cafe-logo.png" />

  <!-- Theme color (matches dark coffee bg) -->
  <meta name="theme-color" content="#1a0d05" />

  <!-- RSS -->
  <link rel="alternate" type="application/rss+xml" title="CashCafe" href="/rss.xml" />

  <!-- Schema.org WebSite -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "Cash Café",
    "url": "https://cash-cafe.org",
    "inLanguage": "es-ES",
    "potentialAction": {
      "@type": "SearchAction",
      "target": "https://cash-cafe.org/blog?q={search_term_string}",
      "query-input": "required name=search_term_string"
    }
  }
  </script>

  <!-- Schema.org LocalBusiness (CafeOrCoffeeShop) — eligibility for Google rich results -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "CafeOrCoffeeShop",
    "@id": "https://cash-cafe.org/#cafe",
    "name": "Cash Café",
    "image": [
      "https://cash-cafe.org/assets/cashcafe-hero.png",
      "https://cash-cafe.org/assets/cash-cafe-logo.png"
    ],
    "logo": "https://cash-cafe.org/assets/cash-cafe-logo.png",
    "url": "https://cash-cafe.org",
    "description": "La cafetería mejor valorada de Beniel (Murcia). Café de especialidad, desayunos caseros y bocadillos en un ambiente familiar.",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Avenida del Reino, 16",
      "addressLocality": "Beniel",
      "addressRegion": "Murcia",
      "postalCode": "30130",
      "addressCountry": "ES"
    },
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": 38.0444,
      "longitude": -1.0511
    },
    "priceRange": "€",
    "servesCuisine": ["Café de especialidad", "Desayunos", "Bocadillos", "Brunch"],
    "openingHoursSpecification": [
      { "@type": "OpeningHoursSpecification", "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"], "opens": "06:45", "closes": "15:00" },
      { "@type": "OpeningHoursSpecification", "dayOfWeek": "Saturday", "opens": "06:45", "closes": "14:00" }
    ],
    "sameAs": [
      "https://www.instagram.com/cashcafe2020/",
      "https://www.facebook.com/cashcafe",
      "https://www.youtube.com/@cashcafe4636",
      "https://flow.page/cashcafe"
    ],
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "4.7",
      "reviewCount": "86",
      "bestRating": "5"
    },
    "hasMap": "https://maps.google.com/?cid=cash+cafe+beniel",
    "amenityFeature": [
      { "@type": "LocationFeatureSpecification", "name": "WiFi", "value": true },
      { "@type": "LocationFeatureSpecification", "name": "Terraza", "value": true },
      { "@type": "LocationFeatureSpecification", "name": "Reservas", "value": true },
      { "@type": "LocationFeatureSpecification", "name": "Take-away", "value": true }
    ]
  }
  </script>
</head>
<body>
  <!-- Full-page coffee video background (decorative) -->
  <div class="site-bg" aria-hidden="true">
    <video class="site-bg-video" autoplay muted loop playsinline preload="auto" poster="/assets/cashcafe-hero.png">
      <source src="/assets/coffee-pour.mp4" type="video/mp4" />
    </video>
    <div class="site-bg-mask"></div>
  </div>

  <Header />
  <main>
    <slot />
  </main>
  <Footer />
  <CookieConsent />
</body>
</html>

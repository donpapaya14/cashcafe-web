---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/content/ArticleCard.astro';
import { getCollection } from 'astro:content';
import { CATEGORIES, getCategoryName } from '../../utils/categories';
import type { Category } from '../../utils/categories';

export function getStaticPaths() {
  return Object.keys(CATEGORIES).map(cat => ({
    params: { category: cat },
  }));
}

const { category } = Astro.params as { category: Category };
const catInfo = CATEGORIES[category];

const posts = await getCollection('blog', ({ data }) => !data.draft && data.category === category);
const sorted = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout
  title={catInfo.name}
  description={`${catInfo.name} on CashCafe — ${catInfo.description.toLowerCase()}.`}
>
  <section class="section blog-hero" style="padding-top:64px;padding-bottom:24px">
    <div class="container">
      <div class="eyebrow">Category</div>
      <h1 class="display" style="font-size:clamp(36px,5vw,68px);margin-top:8px">{catInfo.name}</h1>
      <p class="lede page-subtitle" style="margin-top:16px;max-width:640px">{catInfo.description}</p>
    </div>
  </section>

  <section class="section" style="padding-top:24px">
    <div class="container">
      {sorted.length > 0 ? (
        <div class="articles-grid">
          {sorted.map(post => (
            <ArticleCard
              title={post.data.title}
              description={post.data.description}
              pubDate={post.data.pubDate}
              category={post.data.category}
              slug={post.id}
              image={post.data.image}
              readingTime={post.data.readingTime}
            />
          ))}
        </div>
      ) : (
        <p class="empty">More articles in this category coming soon.</p>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .empty {
    color: var(--ink-3);
    font-style: italic;
    text-align: center;
    padding: 48px 0;
  }
</style>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/content/ArticleCard.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const sorted = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const latestPosts = sorted.slice(0, 3);
// Curiosidades: se actualiza solo desde los artículos de cultura del blog
const curiosidades = sorted.filter(p => p.data.category === 'culture').slice(0, 3);

---

<BaseLayout
  title="Cash Café — Cafetería en Beniel (Murcia)"
  description="Cash Café, cafetería en Beniel (Murcia). Café de especialidad, desayunos caseros, bocadillos y buen ambiente. Av. del Reino 16 · 4,7★ en Google."
>
  <!-- Hero local -->
  <section class="hero">
    <div class="container hero__inner hero-grid">
      <div class="hero-text">
        <div class="eyebrow">Beniel · Murcia · 4,7 en Google</div>
        <h1 class="display hero__title">
          Café de verdad,<br />
          <em>en tu pueblo</em>
        </h1>
        <p class="lede hero__subtitle">
          Una pequeña cafetería en Beniel donde nos tomamos el café muy en serio.
          Especialidad, desayunos caseros y bocadillos cuidados al detalle.
          Sin prisas, sin postureo.
        </p>
        <div class="hero__actions">
          <a href="#carta" class="btn-primary">Ver la carta</a>
          <a href="https://maps.google.com/?cid=cash+cafe+beniel" target="_blank" rel="noopener" class="btn-ghost">Cómo llegar</a>
        </div>

        <div class="pop-chips" aria-label="Información clave">
          <span class="pop-chips-label">Hoy</span>
          <span class="pop-chip">Lun–Vie 06:45–15:00</span>
          <span class="pop-chip">Sáb 06:45–14:00</span>
          <span class="pop-chip">Av. del Reino 16</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Visítanos / mapa + datos clave -->
  <section class="section section--alt visit-section">
    <div class="visit-bg" aria-hidden="true">
      <img src="/assets/cashcafe-interior.png" alt="" loading="lazy" />
    </div>
    <div class="container visit-grid">
      <div class="visit-text">
        <div class="eyebrow">Visítanos</div>
        <h2 class="section-title">Av. del Reino, 16 · Beniel</h2>
        <p class="lede" style="max-width:560px">
          Una cafetería pequeña en el centro de Beniel, donde cuidamos el café y preparamos desayunos caseros cada mañana.
        </p>

        <ul class="visit-info">
          <li><strong>Dirección:</strong> Avenida del Reino, 16, 30130 Beniel (Murcia)</li>
          <li><strong>Horario:</strong> Lun–Vie 06:45–15:00 · Sáb 06:45–14:00 · Dom cerrado</li>
          <li><strong>Valoración:</strong> 4,7/5 (86 reseñas en Google)</li>
        </ul>

        <div class="cta-row">
          <a href="https://maps.google.com/?cid=cash+cafe+beniel" target="_blank" rel="noopener" class="btn-primary">Cómo llegar</a>
        </div>
      </div>
      <div class="map-wrap">
        <iframe
          title="Mapa de Cash Café en Beniel"
          src="https://www.google.com/maps?q=Avenida+del+Reino+16+Beniel+Murcia&output=embed"
          width="100%"
          height="360"
          style="border:0"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
      </div>
    </div>
  </section>

  <style>
    .visit-section {
      position: relative;
      isolation: isolate;
    }
    .visit-bg {
      position: absolute;
      inset: 0;
      z-index: -1;
      overflow: hidden;
    }
    .visit-bg img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      filter: brightness(.4) saturate(1.1);
    }
    .visit-section .visit-text,
    .visit-section .visit-info,
    .visit-section .lede,
    .visit-section .section-title,
    .visit-section .eyebrow {
      color: #fff;
    }
    .visit-section .visit-info strong { color: #fff; }
    .visit-section .map-wrap iframe { border-radius: 12px; box-shadow: 0 6px 30px rgba(0,0,0,.3); }
  </style>

  <!-- Carta -->
  <section id="carta" class="section">
    <div class="container">
      <div class="section__header">
        <div>
          <div class="eyebrow">La carta</div>
          <h2 class="section-title">Lo que servimos</h2>
        </div>
      </div>
      <p class="lede" style="max-width:640px;margin-bottom:24px">
        Café cuidado, desayunos caseros, montaditos calentitos y muy buen ambiente.
        Si tienes una alergia o preferencia, dínoslo y adaptamos.
      </p>

      <div class="menu-grid">
        <div class="menu-block">
          <h3>Cafés</h3>
          <ul>
            <li><span>Espresso</span><span>Tueste cuidado, cuerpo y dulzor</span></li>
            <li><span>Cortado</span><span>Espresso con un toque de leche caliente</span></li>
            <li><span>Café con leche</span><span>Leche entera o vegetal</span></li>
            <li><span>Cappuccino</span><span>Espuma sedosa, cacao opcional</span></li>
            <li><span>Asiático</span><span>El clásico de la zona, especialidad de la casa</span></li>
            <li><span>…y lo que te imagines</span><span>Pídelo como te guste, lo preparamos</span></li>
          </ul>
        </div>

        <div class="menu-block">
          <h3>Desayunos y almuerzos</h3>
          <ul>
            <li><span>Tostada con tomate y AOVE</span><span>Pan crujiente, tomate rallado, aceite virgen extra</span></li>
            <li><span>Tostada con jamón</span><span>Jamón serrano y aceite</span></li>
            <li><span>Bollería</span><span>Cruasanes recién hechos, napolitanas, palmeras…</span></li>
            <li><span>Montaditos variados</span><span>Calentitos al momento — la mejor parada del almuerzo</span></li>
          </ul>
        </div>

        <div class="menu-block">
          <h3>Bocadillos variados</h3>
          <ul>
            <li><span>Bocadillo de tortilla</span><span>Tortilla jugosa de la casa</span></li>
            <li><span>Bocadillo de jamón serrano</span><span>Pan crujiente y aceite</span></li>
            <li><span>Bocadillo de lomo</span><span>Con queso opcional</span></li>
            <li><span>Bocadillo vegetal</span><span>Tomate, lechuga y atún (o sin)</span></li>
            <li><span>Sandwich mixto</span><span>Jamón, queso y tomate, plancha</span></li>
          </ul>
        </div>

        <div class="menu-block">
          <h3>Refrescos y otros</h3>
          <ul>
            <li><span>Té e infusiones</span><span>Variedad de tés sueltos</span></li>
            <li><span>Chocolate caliente</span><span>Espeso, opcional con nata</span></li>
            <li><span>Refrescos</span><span>Agua, refrescos clásicos, cervezas</span></li>
            <li><span>Smoothies</span><span>Pregunta por los del día</span></li>
          </ul>
        </div>
      </div>

      <p class="micro" style="margin-top:24px;color:var(--ink-3)">
        Carta sujeta a cambios estacionales. Precios y opciones específicas, en el local.
      </p>
    </div>
  </section>

  <!-- Tipos de café -->
  <section id="tipos" class="section section--alt">
    <div class="container">
      <div class="section__header">
        <div>
          <div class="eyebrow">Para aprender</div>
          <h2 class="section-title">Tipos de café</h2>
        </div>
      </div>
      <p class="lede" style="max-width:640px;margin-bottom:24px">
        Lo básico para entender lo que hay en tu taza. Si quieres profundizar,
        en el blog lo contamos con calma.
      </p>

      <div class="coffee-types-grid">
        <article class="type-card">
          <div class="type-card__kicker">Variedad</div>
          <h3>Arábica</h3>
          <p>La más cultivada y apreciada. Aromática, con muchos matices, acidez agradable y menos cafeína. Es la base del café de especialidad.</p>
        </article>
        <article class="type-card">
          <div class="type-card__kicker">Variedad</div>
          <h3>Robusta</h3>
          <p>Más cuerpo, sabor intenso y amargo, y casi el doble de cafeína. Aporta crema y fuerza: clave en muchos espressos italianos.</p>
        </article>
        <article class="type-card">
          <div class="type-card__kicker">Tueste</div>
          <h3>Claro o tueste oscuro</h3>
          <p>El tueste claro respeta el origen: más ácido y afrutado. El oscuro es más amargo y achocolatado, con menos matices. Ni mejor ni peor: cuestión de gusto.</p>
        </article>
        <article class="type-card">
          <div class="type-card__kicker">Origen</div>
          <h3>Origen único o mezcla</h3>
          <p>El origen único viene de una sola finca o región y sabe a ese lugar. La mezcla busca equilibrio y constancia, taza tras taza.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- Curiosidades del café (se actualiza solo desde el blog) -->
  <section id="curiosidades" class="section">
    <div class="container">
      <div class="section__header">
        <div>
          <div class="eyebrow">Cultura y curiosidades</div>
          <h2 class="section-title">Curiosidades del café</h2>
        </div>
        <a href="/categoria/culture" class="section__link">Ver más &rarr;</a>
      </div>
      {curiosidades.length > 0 && (
        <div class="articles-grid">
          {curiosidades.map(post => (
            <ArticleCard
              title={post.data.title}
              description={post.data.description}
              pubDate={post.data.pubDate}
              category={post.data.category}
              slug={post.id}
              image={post.data.image}
              readingTime={post.data.readingTime}
            />
          ))}
        </div>
      )}
    </div>
  </section>

  <!-- Contacto -->
  <section id="contacto" class="section">
    <div class="container contact-grid">
      <div>
        <div class="eyebrow">Contacto</div>
        <h2 class="section-title">Pásate a vernos</h2>
        <p class="lede" style="max-width:520px">
          Estamos en el centro de Beniel, a pie de calle. Pásate a tomar un café
          y a desayunar con calma.
        </p>

        <ul class="contact-list">
          <li>
            <strong>Dirección</strong>
            <span>Avenida del Reino, 16 · 30130 Beniel (Murcia)</span>
          </li>
          <li>
            <strong>Horario</strong>
            <span>Lun–Vie 06:45–15:00 · Sáb 06:45–14:00 · Dom cerrado</span>
          </li>
          <li>
            <strong>Valoración</strong>
            <span>4,7★ · 86 reseñas en Google</span>
          </li>
          <li>
            <strong>Google Maps</strong>
            <span><a href="https://www.google.com/maps?q=Avenida+del+Reino+16+Beniel+Murcia" target="_blank" rel="noopener">Cómo llegar</a></span>
          </li>
        </ul>

        <div class="cta-row" style="margin-top:18px">
          <a href="https://maps.google.com/?cid=cash+cafe+beniel" target="_blank" rel="noopener" class="btn-primary">Cómo llegar</a>
        </div>
      </div>
      <div class="map-wrap">
        <iframe
          title="Cómo llegar a Cash Café Beniel"
          src="https://www.google.com/maps?q=Avenida+del+Reino+16+Beniel+Murcia&output=embed"
          width="100%"
          height="380"
          style="border:0"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
      </div>
    </div>
  </section>

  <!-- Blog del barista (SEO support) -->
  <section class="section">
    <div class="container">
      <div class="section__header">
        <div>
          <div class="eyebrow">El diario del barista</div>
          <h2 class="section-title">Lo último del blog</h2>
        </div>
        <a href="/blog" class="section__link">Ver todos &rarr;</a>
      </div>
      <div class="articles-grid">
        {latestPosts.map(post => (
          <ArticleCard
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            category={post.data.category}
            slug={post.id}
            image={post.data.image}
            readingTime={post.data.readingTime}
          />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-text { max-width: 760px; }
  .hero__title em { font-style: italic; color: var(--accent); }

  .visit-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: start;
  }
  .visit-info {
    list-style: none;
    padding: 0;
    margin: 20px 0 18px;
    color: var(--ink-2);
    font-size: 15px;
    line-height: 1.7;
  }
  .visit-info li { padding: 6px 0; border-bottom: 0.5px solid var(--line); }
  .visit-info strong { color: var(--ink-1); margin-right: 6px; }
  .cta-row { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 8px; }
  .map-wrap {
    border: 0.5px solid var(--line);
    border-radius: 14px;
    overflow: hidden;
    box-shadow: var(--shadow-md);
  }

  .signature-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-top: 16px;
  }
  .signature-card {
    padding: 28px 24px;
    border: 0.5px solid var(--line);
    border-radius: 14px;
    background: color-mix(in oklab, var(--bg) 85%, transparent);
    box-shadow: var(--shadow-md);
  }
  .signature-card h3 {
    font-family: var(--font-display);
    font-size: 22px;
    margin-bottom: 8px;
    color: var(--ink-1);
  }
  .signature-card p {
    color: var(--ink-2);
    font-size: 14.5px;
    line-height: 1.6;
  }

  /* Carta */
  .menu-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 32px;
    margin-top: 16px;
  }
  .menu-block {
    padding: 24px;
    border: 0.5px solid var(--line);
    border-radius: 14px;
    background: color-mix(in oklab, var(--bg) 85%, transparent);
  }
  .menu-block h3 {
    font-family: var(--font-display);
    font-size: 22px;
    color: var(--ink-1);
    border-bottom: 0.5px solid var(--line);
    padding-bottom: 8px;
    margin-bottom: 12px;
  }
  .menu-block ul { list-style: none; padding: 0; margin: 0; }
  .menu-block li {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2px;
    padding: 10px 0;
    border-bottom: 0.5px dashed var(--line);
  }
  .menu-block li:last-child { border-bottom: none; }
  .menu-block li span:first-child {
    font-weight: 600;
    color: var(--ink-1);
    font-size: 15.5px;
  }
  .menu-block li span:last-child {
    color: var(--ink-2);
    font-size: 13.5px;
    line-height: 1.5;
  }

  /* Tipos de café */
  .coffee-types-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin-top: 16px;
  }
  .type-card {
    padding: 24px 22px;
    border: 0.5px solid var(--line);
    border-radius: 14px;
    background: color-mix(in oklab, var(--bg) 85%, transparent);
    box-shadow: var(--shadow-md);
    display: flex;
    flex-direction: column;
    gap: 8px;
    transition: border-color .2s ease, transform .2s ease;
  }
  .type-card:hover { border-color: var(--line-strong); transform: translateY(-2px); }
  .type-card__kicker {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--accent);
    font-weight: 700;
  }
  .type-card h3 {
    font-family: var(--font-display);
    font-size: 21px;
    color: var(--ink-1);
  }
  .type-card p {
    color: var(--ink-2);
    font-size: 14px;
    line-height: 1.6;
    flex-grow: 1;
  }
  @media (max-width: 1040px) {
    .coffee-types-grid { grid-template-columns: repeat(2, 1fr); }
  }

  /* Contacto */
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: start;
  }
  .contact-list {
    list-style: none;
    padding: 0;
    margin: 18px 0;
  }
  .contact-list li {
    display: grid;
    grid-template-columns: 130px 1fr;
    gap: 12px;
    padding: 10px 0;
    border-bottom: 0.5px solid var(--line);
    font-size: 14.5px;
  }
  .contact-list strong {
    color: var(--ink-1);
    font-weight: 600;
  }
  .contact-list a {
    color: var(--accent);
    border-bottom: 1px dotted var(--accent);
    text-decoration: none;
  }
  .contact-list a:hover { color: var(--ink-1); }

  @media (max-width: 900px) {
    .visit-grid,
    .signature-grid,
    .coffee-types-grid,
    .menu-grid,
    .contact-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 600px) {
    .hero__actions { flex-direction: column; align-items: flex-start; }
    .hero__actions .btn-primary,
    .hero__actions .btn-ghost { width: 100%; justify-content: center; }
    .contact-list li { grid-template-columns: 1fr; gap: 2px; }
  }
</style>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/content/ArticleCard.astro';
import { getCollection } from 'astro:content';
import { CATEGORIES } from '../utils/categories';
import type { Category } from '../utils/categories';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const latestPosts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 6);

const categories = Object.entries(CATEGORIES) as [Category, (typeof CATEGORIES)[Category]][];
---

<BaseLayout title="CashCafe" description="Coffee science, brewing, and cafe culture. Honest guides on espresso, pour over, gear, and recipes — backed by real data.">
  <!-- Hero -->
  <section class="hero">
    <div class="container hero__inner">
      <h1 class="hero__title">Coffee, <span>seriously brewed</span></h1>
      <p class="hero__subtitle">
        Brewing science, honest gear reviews, and recipes that actually work at home.
        No marketing fluff — just what makes the cup better.
      </p>
      <div class="hero__actions">
        <a href="/blog" class="btn btn--primary">Read articles</a>
        <a href="/newsletter" class="btn btn--outline">Subscribe</a>
      </div>
    </div>
  </section>

  <!-- Latest Articles -->
  <section class="section">
    <div class="container">
      <div class="section__header">
        <h2>Latest articles</h2>
        <a href="/blog" class="section__link">See all &rarr;</a>
      </div>
      <div class="articles-grid">
        {latestPosts.map(post => (
          <ArticleCard
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            category={post.data.category}
            slug={post.id}
            image={post.data.image}
            readingTime={post.data.readingTime}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Categories -->
  <section class="section section--alt">
    <div class="container">
      <h2 class="section__heading-center">Explore by category</h2>
      <div class="categories-grid">
        {categories.map(([key, cat]) => (
          <a href={`/categoria/${key}`} class={`cat-card cat-card--${key}`}>
            <h3>{cat.name}</h3>
            <p>{cat.description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Newsletter CTA -->
  <section class="section newsletter-hero">
    <div class="container newsletter-hero__inner">
      <h2>Coffee tips in your inbox every Sunday</h2>
      <p>Join our free newsletter. No spam, just brews and gear notes.</p>
      <a
        href="/newsletter"
        class="btn btn--primary btn--lg"
      >
        Subscribe free
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    background: linear-gradient(135deg, #2B1F14 0%, #4B3621 50%, #2B1F14 100%);
    color: white;
    padding: 5rem 0 4rem;
  }
  .hero__inner { max-width: 700px; }
  .hero__title {
    font-size: 3rem;
    font-weight: 800;
    line-height: 1.15;
    color: white;
  }
  .hero__title span { color: var(--color-accent); }
  .hero__subtitle {
    font-size: 1.125rem;
    color: #D6CFC4;
    margin-top: 1.25rem;
    line-height: 1.7;
  }
  .hero__actions {
    display: flex;
    gap: 1rem;
    margin-top: 2rem;
  }
  .hero .btn--outline {
    color: white;
    border-color: rgba(255,255,255,0.3);
  }
  .hero .btn--outline:hover {
    background: rgba(255,255,255,0.1);
    color: white;
  }
  .section { padding: 4rem 0; }
  .section--alt { background: #F1EAE0; }
  .section__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
  }
  .section__link {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-primary);
  }
  .section__heading-center {
    text-align: center;
    margin-bottom: 2rem;
  }
  .articles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5rem;
  }
  .categories-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 1rem;
  }
  .cat-card {
    display: block;
    padding: 1.5rem;
    border-radius: var(--radius);
    color: white;
    transition: transform 0.2s, box-shadow 0.2s;
    text-decoration: none;
  }
  .cat-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-lg);
    color: white;
  }
  .cat-card h3 { font-size: 1.125rem; margin-bottom: 0.5rem; color: white; }
  .cat-card p { font-size: 0.8125rem; opacity: 0.9; }
  .cat-card--guides   { background: #6F4E37; }
  .cat-card--recipes  { background: #B5651D; }
  .cat-card--culture  { background: #8B5A2B; }
  .cat-card--gear     { background: #4B3621; }
  .cat-card--brewing  { background: #A0522D; }
  .cat-card--espresso { background: #2B1F14; }
  .newsletter-hero {
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
    color: white;
  }
  .newsletter-hero__inner { text-align: center; max-width: 550px; margin: 0 auto; }
  .newsletter-hero h2 { color: white; font-size: 1.75rem; }
  .newsletter-hero p { color: var(--color-accent-light); margin: 1rem 0 1.5rem; }
  .newsletter-hero .btn--primary {
    background: white;
    color: var(--color-primary);
  }
  .newsletter-hero .btn--primary:hover { background: #F5EFE6; }
  .btn--lg { padding: 0.875rem 2rem; font-size: 1rem; }
  @media (max-width: 600px) {
    .hero { padding: 3rem 0; }
    .hero__title { font-size: 2rem; }
    .hero__actions { flex-direction: column; }
    .articles-grid { grid-template-columns: 1fr; }
  }
</style>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/content/ArticleCard.astro';
import { getCollection } from 'astro:content';
import { CATEGORIES } from '../utils/categories';
import type { Category } from '../utils/categories';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const latestPosts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 6);

const categories = Object.entries(CATEGORIES) as [Category, (typeof CATEGORIES)[Category]][];
---

<BaseLayout title="CashCafe" description="Coffee science, brewing, and cafe culture. Honest guides on espresso, pour over, gear, and recipes — backed by real data.">
  <!-- Hero -->
  <section class="hero">
    <div class="container hero__inner hero-grid">
      <div class="hero-text">
        <div class="eyebrow">An editorial coffee guide</div>
        <h1 class="display hero__title">
          Coffee,<br />
          <em>seriously brewed</em>
        </h1>
        <p class="lede hero__subtitle">
          Brewing science, honest gear reviews, and recipes that actually work at home.
          No marketing fluff — just what makes the cup better.
        </p>
        <div class="hero__actions">
          <a href="/blog" class="btn-primary">Read articles &rarr;</a>
          <a href="#categories" class="btn-ghost">Explore categories</a>
        </div>

        <div class="pop-chips" aria-label="Popular topics">
          <span class="pop-chips-label">Popular</span>
          <a href="/categoria/espresso" class="pop-chip">Espresso</a>
          <a href="/categoria/brewing" class="pop-chip">V60 &amp; pour over</a>
          <a href="/categoria/gear" class="pop-chip">Grinders</a>
          <a href="/categoria/recipes" class="pop-chip">Recipes</a>
          <a href="/categoria/culture" class="pop-chip">Cafés del mundo</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Latest Articles -->
  <section class="section">
    <div class="container">
      <div class="section__header">
        <div>
          <div class="eyebrow">Recent</div>
          <h2 class="section-title">Latest articles</h2>
        </div>
        <a href="/blog" class="section__link">See all &rarr;</a>
      </div>
      <div class="articles-grid">
        {latestPosts.map(post => (
          <ArticleCard
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            category={post.data.category}
            slug={post.id}
            image={post.data.image}
            readingTime={post.data.readingTime}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Categories -->
  <section id="categories" class="section section--alt">
    <div class="container">
      <div style="text-align:center;margin-bottom:36px">
        <div class="eyebrow" style="justify-content:center">Explore</div>
        <h2 class="section-title">By category</h2>
      </div>
      <div class="categories-grid">
        {categories.map(([key, cat]) => (
          <a href={`/categoria/${key}`} class={`cat-card cat-card--${key}`}>
            <h3>{cat.name}</h3>
            <p>{cat.description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Newsletter CTA -->
  <section class="section newsletter-hero">
    <div class="container newsletter-hero__inner">
      <div class="eyebrow" style="justify-content:center">Newsletter</div>
      <h2 class="section-title">Coffee tips in your inbox every Sunday</h2>
      <p>Join our free newsletter. No spam, just brews and gear notes.</p>
      <a href="/about" class="btn-primary btn--lg">Subscribe free &rarr;</a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-text { max-width: 760px; }
  .hero__title em { font-style: italic; color: var(--accent); }

  /* Per-category accent edge */
  .cat-card--guides   { box-shadow: inset 4px 0 0 #6F4E37, var(--shadow-md); }
  .cat-card--recipes  { box-shadow: inset 4px 0 0 #B5651D, var(--shadow-md); }
  .cat-card--culture  { box-shadow: inset 4px 0 0 #8B5A2B, var(--shadow-md); }
  .cat-card--gear     { box-shadow: inset 4px 0 0 #4B3621, var(--shadow-md); }
  .cat-card--brewing  { box-shadow: inset 4px 0 0 #A0522D, var(--shadow-md); }
  .cat-card--espresso { box-shadow: inset 4px 0 0 var(--accent), var(--shadow-md); }

  @media (max-width: 600px) {
    .hero__actions { flex-direction: column; align-items: flex-start; }
    .hero__actions .btn-primary,
    .hero__actions .btn-ghost { width: 100%; justify-content: center; }
  }
</style>

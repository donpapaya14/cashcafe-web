---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/content/ArticleCard.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title="All articles" description="All Cash Café articles on coffee science, brewing, espresso, gear, recipes, and cafe culture.">
  <section class="section blog-hero" style="padding-top:64px;padding-bottom:24px">
    <div class="container">
      <div class="eyebrow">Blog</div>
      <h1 class="display" style="font-size:clamp(36px,5vw,68px);margin-top:8px">All articles</h1>
      <p class="lede page-subtitle" style="margin-top:16px;max-width:640px">
        Coffee science and brewing, no marketing fluff
      </p>
    </div>
  </section>

  <section class="section" style="padding-top:24px">
    <div class="container">
      <div class="articles-grid">
        {sortedPosts.map(post => (
          <ArticleCard
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            category={post.data.category}
            slug={post.id}
            image={post.data.image}
            readingTime={post.data.readingTime}
          />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

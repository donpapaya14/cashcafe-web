---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About Cash Café" description="Cash Café — coffee science, brewing, and cafe culture. Honest guides without the marketing fluff.">
  <section class="about">
    <div class="container about__inner">
      <div class="eyebrow">About</div>
      <h1 class="display" style="font-size:clamp(36px,5vw,64px);margin-top:8px">Cash <em>Café</em></h1>
      <p class="lede" style="margin-top:18px;max-width:640px">
        An editorial coffee guide focused on what actually changes the cup.
      </p>

      <p>We cover brewing methods (espresso, V60, Chemex, AeroPress, French press), gear that lasts, and the science behind extraction. No hype, no copy-paste reviews.</p>

      <h2 class="section-title" style="margin-top:40px">What we publish</h2>
      <ul>
        <li><strong>Brewing guides</strong> — step-by-step methods with measured ratios and times</li>
        <li><strong>Gear reviews</strong> — what's worth buying at each price tier, what's a waste</li>
        <li><strong>Recipes</strong> — drinks worth making, with the technique that makes them work</li>
        <li><strong>Coffee culture</strong> — origins, history, and shop visits</li>
      </ul>

      <h2 class="section-title" style="margin-top:40px">Our approach</h2>
      <ul>
        <li><strong>Cite real sources</strong> — SCA standards, peer-reviewed studies, named baristas</li>
        <li><strong>No miracle products</strong> — we don't promote scam gadgets or pyramid suppliers</li>
        <li><strong>Affiliate transparency</strong> — Amazon links may earn a commission at no extra cost</li>
        <li><strong>Free content</strong> — every guide is free to read, forever</li>
      </ul>

      <h2 class="section-title" style="margin-top:40px">Contact</h2>
      <p><a href="mailto:vladys.z96@gmail.com">vladys.z96@gmail.com</a></p>
    </div>
  </section>
</BaseLayout>

<style>
  .about { padding: 56px 0 80px; }
  .about__inner { max-width: var(--content-width); }
  .about h1 em { font-style: italic; color: var(--accent); }
  .about p {
    margin-bottom: 1rem;
    color: var(--ink-2);
    line-height: 1.7;
    font-size: 16px;
  }
  .about ul {
    padding-left: 1.25rem;
    margin: 12px 0 24px;
  }
  .about li {
    margin-bottom: 0.5rem;
    color: var(--ink-2);
    line-height: 1.55;
    font-size: 15px;
  }
  .about strong { color: var(--ink-1); }
  .about a { color: var(--accent); border-bottom: 1px dotted var(--accent); }
  .about a:hover { color: var(--ink-1); border-bottom-color: var(--ink-1); }
</style>

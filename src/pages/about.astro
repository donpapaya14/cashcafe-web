---
import BaseLayout from '../layouts/BaseLayout.astro';

const PHONE = '{{ PHONE_HERE }}';
const WA_NUMBER = '{{ WHATSAPP_HERE }}';
const WA_MSG = encodeURIComponent('Hola, vengo de la web de Cash Cafe.');
const waLink = `https://wa.me/${WA_NUMBER}?text=${WA_MSG}`;
---

<BaseLayout
  title="Sobre nosotros · Cash Café"
  description="Cash Café es una pequeña cafetería familiar en Beniel (Murcia). 4,7 en Google. Café de especialidad, desayunos caseros y cariño en cada taza."
>
  <section class="about">
    <div class="container about__inner">
      <div class="eyebrow">Sobre nosotros</div>
      <h1 class="display" style="font-size:clamp(36px,5vw,64px);margin-top:8px">Cash <em>Café</em></h1>
      <p class="lede" style="margin-top:18px;max-width:640px">
        Una cafetería pequeña con una obsesión grande.
      </p>

      <p>
        Somos Cash Café, un pequeño rincón en <strong>Beniel, Murcia</strong>, donde nos tomamos el café muy en serio.
        No somos una cadena ni una franquicia — somos una familia que un día decidió que en este pueblo se merecía un café de verdad.
      </p>

      <p>
        Empezamos con una idea sencilla: <em>hacer las cosas bien</em>. Cada taza, cada tostada, cada detalle.
        No buscamos ser los más grandes, sino los que más cariño ponen en lo que hacen.
      </p>

      <p>
        Con <strong>4,7 en Google Maps</strong> somos la cafetería mejor valorada de Beniel.
        Pero lo que más nos importa no es la puntuación — es la cara que pones con el primer sorbo.
      </p>

      <h2 class="section-title" style="margin-top:40px">Lo que servimos</h2>
      <ul>
        <li><strong>Café de especialidad</strong> — espresso, V60, AeroPress y leches vegetales</li>
        <li><strong>Desayunos caseros</strong> — tostadas, bollería del día y zumo natural</li>
        <li><strong>Bocadillos variados</strong> — pan crujiente y producto fresco</li>
      </ul>

      <h2 class="section-title" style="margin-top:40px">Cómo somos</h2>
      <ul>
        <li><strong>Familiares</strong> — el local lo llevamos nosotros, conocemos a quien entra</li>
        <li><strong>Cuidadosos</strong> — molienda, dosis y temperatura medidas, no improvisamos</li>
        <li><strong>Honestos</strong> — si no es bueno, no sale; si no nos gusta, no lo vendemos</li>
        <li><strong>Cercanos</strong> — terraza, wifi y mesa libre para trabajar la mañana</li>
      </ul>

      <h2 class="section-title" style="margin-top:40px">Encuéntranos</h2>
      <p>
        Avenida del Reino, 16 · 30130 Beniel (Murcia)<br />
        Lun–Vie 06:45–15:00 · Sáb 06:45–14:00 · Dom cerrado
      </p>
      <p>
        <a href={waLink} target="_blank" rel="noopener">WhatsApp</a> ·
        <a href={`tel:${PHONE}`}>Llamar</a> ·
        <a href="https://maps.google.com/?cid=cash+cafe+beniel" target="_blank" rel="noopener">Cómo llegar</a>
      </p>
      <p>
        <a href="https://www.instagram.com/cashcafe2020/" target="_blank" rel="noopener">Instagram</a> ·
        <a href="https://www.facebook.com/cashcafe" target="_blank" rel="noopener">Facebook</a> ·
        <a href="https://www.youtube.com/@cashcafe4636" target="_blank" rel="noopener">YouTube</a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .about { padding: 56px 0 80px; }
  .about__inner { max-width: var(--content-width); }
  .about h1 em { font-style: italic; color: var(--accent); }
  .about p {
    margin-bottom: 1rem;
    color: var(--ink-2);
    line-height: 1.7;
    font-size: 16px;
  }
  .about ul {
    padding-left: 1.25rem;
    margin: 12px 0 24px;
  }
  .about li {
    margin-bottom: 0.5rem;
    color: var(--ink-2);
    line-height: 1.55;
    font-size: 15px;
  }
  .about strong { color: var(--ink-1); }
  .about a { color: var(--accent); border-bottom: 1px dotted var(--accent); }
  .about a:hover { color: var(--ink-1); border-bottom-color: var(--ink-1); }
</style>

---
interface Props {
  position: 'top' | 'mid' | 'bottom' | 'sidebar';
}

const { position } = Astro.props;

const sizes: Record<string, string> = {
  top: 'min-height: 90px',
  mid: 'min-height: 250px',
  bottom: 'min-height: 90px',
  sidebar: 'min-height: 250px; max-width: 300px',
};
---

<div class="ad-slot" data-ad-position={position} style={sizes[position]}>
  <!-- AdSense ad unit will render here after cookie consent + approval -->
</div>

<style>
  .ad-slot {
    background: var(--surface-1);
    border: 0.5px dashed var(--line-strong);
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 1.5rem 0;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-3);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }
  .ad-slot::after { content: 'Advertisement'; }
</style>
